# Configuration gratuite recommandée : Groq
LLM_API_URL=https://api.groq.com/openai/v1
LLM_API_KEY=remplacez-par-votre-cle-groq
LLM_MODEL=openai/gpt-oss-20b
LLM_FALLBACK_MODELS=openai/gpt-oss-120b,qwen/qwen3.6-27b
MAX_CONTEXT_CHARS=14000
MAX_OUTPUT_TOKENS=1200
PROVIDER_RETRIES=1

# Agent Workspace Linux — Vercel Sandbox recommandé
VERCEL_TOKEN=remplacez-par-votre-token-vercel
VERCEL_TEAM_ID=team_xxx
VERCEL_PROJECT_ID=prj_xxx

# Solution de secours facultative
E2B_API_KEY=

# Création d’images dans le workspace
POLLINATIONS_API_KEY=remplacez-par-votre-cle-pollinations
IMAGE_MODEL=zimage

# Facultatif sur un VPS avec Caddy ; Render fournit son propre sous-domaine HTTPS.
DOMAIN=ia.example.bf
ACME_EMAIL=admin@example.bf

# Facultatif : recherche web gérée par Wangala
TAVILY_API_KEY=

RATE_LIMIT_PER_MINUTE=30
